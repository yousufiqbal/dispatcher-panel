# Required — your Turso (libSQL) database URL + auth token. One database per store.
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Required — the Shopify store this deployment works on (one store per deployment).
# The token is the Admin API access token of the store's custom app (shpat_…).
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_change_this"

# Required — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_this_to_a_random_64_char_hex_string"
ENCRYPTION_KEY="change_this_to_a_random_64_char_hex_string"

# Note: there's no account-seeding step — the first visit to /login on an empty
# database shows a one-time "set up the owner account" form instead.

